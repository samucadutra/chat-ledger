# ChatLedger configuration template. Every setting read by chatledger_core/config.py.
# docker-compose.yml applies these defaults; copy to .env to override locally.

# --- Database
DATABASE_URL=postgresql+psycopg://chatledger:chatledger@db:5432/chatledger
TEST_DATABASE_URL=postgresql+psycopg://chatledger:chatledger@localhost:5432/chatledger_test

# --- Storage
BLOB_ROOT=/data/blobs

# --- Build metadata (normally resolved from /app/GIT_SHA at image build time)
# GIT_SHA=

# --- Runtime
LOG_LEVEL=INFO
TZ=UTC
CORS_ORIGINS=http://localhost:3000

# --- Job queue / worker
JOB_LEASE_SECONDS=60
JOB_LEASE_RENEW_SECONDS=20
JOB_SWEEP_INTERVAL_SECONDS=15
JOB_POLL_INTERVAL_SECONDS=1.0
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BACKOFF_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=10
WORKER_ACTIVE_WINDOW_SECONDS=30

# --- Intake (matters and collections)
MAX_UPLOAD_BYTES=2147483648
UPLOAD_CHUNK_BYTES=8388608
UPLOAD_STALE_SECONDS=600
UPLOAD_JANITOR_INTERVAL_SECONDS=60
MAX_COLLECTIONS_PER_MATTER=20
ARCHIVE_MAX_ENTRIES=200000
ARCHIVE_MAX_UNCOMPRESSED_BYTES=21474836480
ARCHIVE_MAX_RATIO=100
ARCHIVE_RATIO_MIN_ENTRY_BYTES=1048576

# --- Synthetic generator (F03)
GENERATOR_BYTES_PER_MESSAGE=350
GENERATOR_DISK_HEADROOM=1.5
GENERATOR_PROGRESS_EVERY=5000
# Test-only knobs, inert at their defaults:
#   GENERATOR_FREE_SPACE_OVERRIDE_BYTES replaces the measured free space in the disk check
#   GENERATOR_TEST_DELAY_MS_PER_CONVERSATION pauses after each generated conversation
#   GENERATOR_TEST_FAIL_ALWAYS makes every generation attempt fail at start
# GENERATOR_FREE_SPACE_OVERRIDE_BYTES=
GENERATOR_TEST_DELAY_MS_PER_CONVERSATION=0
GENERATOR_TEST_FAIL_ALWAYS=false

# --- Web
NEXT_PUBLIC_API_URL=http://localhost:8000
