# ChatLedger configuration template. Every setting read by chatledger_core/config.py.
# docker-compose.yml applies these defaults; copy to .env to override locally.

# --- Database
DATABASE_URL=postgresql+psycopg://chatledger:chatledger@db:5432/chatledger
TEST_DATABASE_URL=postgresql+psycopg://chatledger:chatledger@localhost:5432/chatledger_test

# --- Storage
BLOB_ROOT=/data/blobs

# --- Build metadata (normally resolved from /app/GIT_SHA at image build time)
# GIT_SHA=

# --- Runtime
LOG_LEVEL=INFO
TZ=UTC
CORS_ORIGINS=http://localhost:3000

# --- Job queue / worker
JOB_LEASE_SECONDS=60
JOB_LEASE_RENEW_SECONDS=20
JOB_SWEEP_INTERVAL_SECONDS=15
JOB_POLL_INTERVAL_SECONDS=1.0
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BACKOFF_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=10
WORKER_ACTIVE_WINDOW_SECONDS=30

# --- Web
NEXT_PUBLIC_API_URL=http://localhost:8000
