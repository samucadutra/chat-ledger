# Configuration read by the Python test suite (loaded by the root conftest.py).
# Variables already set in the environment take precedence (e.g. CI or a local
# TEST_DATABASE_URL pointing at a different port).
TEST_DATABASE_URL=postgresql+psycopg://chatledger:chatledger@localhost:5432/chatledger_test
DATABASE_URL=postgresql+psycopg://chatledger:chatledger@localhost:5432/chatledger_test
BLOB_ROOT=/tmp/chatledger-test-blobs
LOG_LEVEL=WARNING
TZ=UTC
CORS_ORIGINS=http://localhost:3000
JOB_LEASE_SECONDS=5
JOB_LEASE_RENEW_SECONDS=1
JOB_SWEEP_INTERVAL_SECONDS=2
JOB_POLL_INTERVAL_SECONDS=0.1
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BACKOFF_SECONDS=0
HEARTBEAT_INTERVAL_SECONDS=1
WORKER_ACTIVE_WINDOW_SECONDS=30
